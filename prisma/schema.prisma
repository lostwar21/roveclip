generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  BRAND
  CLIPPER
  ADMIN
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum SubmissionStatus {
  PENDING
  VALIDATING
  MANUAL_REVIEW
  APPROVED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  PAYOUT
  WITHDRAWAL
  FEE
}

enum Platform {
  TIKTOK
  YOUTUBE
  INSTAGRAM
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  role           Role     @default(CLIPPER)
  name           String
  email          String   @unique
  password       String?  // Optional for OAuth, required for Credentials
  wallet_balance Decimal  @default(0.0) @db.Decimal(10, 2)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  campaigns          Campaign[]
  submissions        Submission[]
  transactions       TransactionLedger[]
  social_connections SocialConnection[]
}

model Campaign {
  id           String         @id @default(uuid()) @db.Uuid
  brand_id     String         @db.Uuid
  video_url    String
  cpm_rate         Decimal        @db.Decimal(10, 2)
  total_budget     Decimal        @db.Decimal(10, 2)
  reserved_budget  Decimal        @default(0.0) @db.Decimal(10, 2)
  spent_budget     Decimal        @default(0.0) @db.Decimal(10, 2)
  remaining_budget Decimal        @default(0.0) @db.Decimal(10, 2)
  status           CampaignStatus @default(ACTIVE)
  start_date   DateTime?
  end_date     DateTime?
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  brand        User           @relation(fields: [brand_id], references: [id], onDelete: Cascade)
  submissions  Submission[]

  @@index([brand_id])
  @@index([status])
}

model Submission {
  id              String           @id @default(uuid()) @db.Uuid
  campaign_id     String           @db.Uuid
  clipper_id      String           @db.Uuid
  platform        Platform
  social_url      String
  validated_views Int              @default(0)
  status          SubmissionStatus @default(PENDING)
  snapshot_date   DateTime?
  ai_notes        String?
  relevance_score Int              @default(0)
  likes           Int              @default(0)
  comments        Int              @default(0)
  author_name     String?
  author_url      String?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  campaign               Campaign               @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  clipper                User                   @relation(fields: [clipper_id], references: [id], onDelete: Cascade)
  transactions           TransactionLedger[]
  verification_snapshots VerificationSnapshot[]

  @@index([campaign_id])
  @@index([clipper_id])
  @@index([status])
}

model TransactionLedger {
  id           String          @id @default(uuid()) @db.Uuid
  user_id      String          @db.Uuid
  amount       Decimal         @db.Decimal(10, 2)
  type         TransactionType
  reference_id String?         @db.Uuid
  created_at   DateTime        @default(now())

  user         User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  submission   Submission?     @relation(fields: [reference_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([reference_id])
  @@index([type])
}

model SocialConnection {
  id                 String    @id @default(uuid()) @db.Uuid
  user_id            String    @db.Uuid
  platform           Platform

  platform_user_id   String
  username           String?

  access_token_enc   String
  token_expires_at   DateTime?
  scopes             String?

  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([platform, platform_user_id])
  @@index([user_id, platform])
}

model VerificationSnapshot {
  id                  String   @id @default(uuid()) @db.Uuid
  submission_id       String   @db.Uuid

  source              String
  status              String

  media_id            String?
  owner_verified      Boolean

  views               Int?
  likes               Int?
  comments            Int?
  reach               Int?

  checked_at          DateTime @default(now())
  metadata            Json?

  submission Submission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  
  @@index([submission_id])
  @@index([checked_at])
}
